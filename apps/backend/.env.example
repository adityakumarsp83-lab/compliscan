# Backend Environment Variables
# Copy this to .env and fill in your values

# Google Gemini API Key (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision API Key (REST API)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# PaddleOCR Microservice URL (optional, defaults to http://127.0.0.1:8000/ocr)
PADDLE_OCR_SERVICE_URL=http://127.0.0.1:8000/ocr

# JWT Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=4000

# ── Neon PostgreSQL ──
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/compliscan?sslmode=verify-full&channel_binding=require
